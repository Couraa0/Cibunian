# ==========================================
# RUNA BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Port server (hanya dipakai saat development lokal, di Vercel otomatis diatur platform)
PORT=3000
NODE_ENV=production

# URL Frontend yang diizinkan mengakses API (CORS).
# - Lokal: http://localhost:5173
# - Vercel: Isi dengan URL deployment frontend Anda (tanpa garis miring di akhir).
#   Contoh: CORS_ORIGIN="https://runa-frontend.vercel.app"
#   Bisa lebih dari satu origin (pisahkan dengan koma), misal:
#   CORS_ORIGIN="https://runa-frontend.vercel.app,http://localhost:5173"
CORS_ORIGIN=*

# ==========================================
# DATABASE (PostgreSQL / Supabase / Neon)
# ==========================================
# Lokal development:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Untuk Vercel Serverless (Supabase / Neon):
# Gunakan Transaction Pooler (port 6543) untuk DATABASE_URL agar koneksi serverless tidak habis:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Database khusus tes e2e (hanya untuk development lokal)
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# Wajib diisi! Buat token rahasia acak: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=runa_jwt_secret_ganti_dengan_token_acak_yang_sangat_panjang_dan_aman

# Kunci otentikasi timbangan IoT ESP32 pada header X-Device-Key
IOT_DEVICE_KEY=runa_device_key_rahasia_123

# Password awal akun admin saat database di-seed (username: admin)
SEED_ADMIN_PASSWORD=AdminPassword123!
